    <ProjectReference Include="..\..\material\Project\Workflow.Engine\Workflow.Engine.vbproj" />
    <ProjectReference Include="..\..\material\Project\Blocks.RouteDispatch\Blocks.RouteDispatch.vbproj" />
    <ProjectReference Include="..\..\material\Project\Blocks.HoldLot\Blocks.HoldLot.vbproj" />
    <ProjectReference Include="..\..\material\Project\Blocks.EquipmentCheck\Blocks.EquipmentCheck.vbproj" />
    <ProjectReference Include="..\..\material\Project\Blocks.AlarmNotify\Blocks.AlarmNotify.vbproj" />
    <ProjectReference Include="..\..\material\Project\Blocks.TokenGenerate\Blocks.TokenGenerate.vbproj" />
    <ProjectReference Include="..\..\material\Project\Blocks.CommandSubmit\Blocks.CommandSubmit.vbproj" />
    <ProjectReference Include="..\..\material\Project\Business.Route\Business.Route.vbproj" />
    <ProjectReference Include="..\..\material\Project\Business.Equipment\Business.Equipment.vbproj" />
    <ProjectReference Include="..\..\material\Project\Business.Command\Business.Command.vbproj" />
    <ProjectReference Include="..\..\material\Project\Repository.Route\Repository.Route.vbproj" />
    <ProjectReference Include="..\..\material\Project\Repository.Equipment\Repository.Equipment.vbproj" />
    <ProjectReference Include="..\..\material\Project\Repository.Command\Repository.Command.vbproj" />
    <ProjectReference Include="..\..\material\Project\Infra.FileDb\Infra.FileDb.vbproj" />
    <ProjectReference Include="..\..\material\Project\Infra.Logging\Infra.Logging.vbproj" />
    <ProjectReference Include="..\..\material\Project\Infra.HttpMock\Infra.HttpMock.vbproj" />
